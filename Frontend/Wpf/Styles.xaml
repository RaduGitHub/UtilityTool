<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="ToolAccent" Color="#91C9FF"/>
  <SolidColorBrush x:Key="ToolMuted" Color="#A6ADB9"/>
  <SolidColorBrush x:Key="ToolSurface" Color="#252A33"/>
  <SolidColorBrush x:Key="ToolBorder" Color="#383F4A"/>
  <Style x:Key="ToolPassword" TargetType="PasswordBox">
    <Setter Property="Background" Value="#30353E"/><Setter Property="Foreground" Value="#EDF1F7"/><Setter Property="CaretBrush" Value="#EDF1F7"/>
    <Setter Property="BorderBrush" Value="#414854"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="16"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
      <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
        <!-- PasswordBox applies its padding to the text host; duplicating it here clips mask glyphs. -->
        <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" Margin="0" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#91C9FF"/><Setter TargetName="Field" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ToolTile" TargetType="ToggleButton">
    <Setter Property="Height" Value="146"/><Setter Property="Margin" Value="5"/>
    <Setter Property="Background" Value="#252A33"/><Setter Property="BorderBrush" Value="#383F4A"/>
    <Setter Property="Foreground" Value="#EDF1F7"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Tile" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#303B4A"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tile" Property="Background" Value="#253D55"/><Setter TargetName="Tile" Property="BorderBrush" Value="#91C9FF"/><Setter TargetName="Tile" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger>
        <DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="Cursor" Value="Arrow"/></DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ToolTileOptions" TargetType="Button">
    <Setter Property="Width" Value="24"/><Setter Property="Height" Value="28"/>
    <Setter Property="Margin" Value="0,0,10,9"/><Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Bottom"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#A6ADB9"/>
    <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Visibility" Value="Hidden"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Options" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Options" Property="Background" Value="#414C5A"/><Setter Property="Foreground" Value="#EDF1F7"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Options" Property="BorderBrush" Value="#91C9FF"/><Setter Property="Foreground" Value="#EDF1F7"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="ToolTileTemplate">
    <Grid x:Name="TileRoot">
    <ToggleButton Style="{StaticResource ToolTile}" IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding Editable}" Command="{Binding PlayCommand}" CommandParameter="{Binding}" ToolTip="{Binding Name}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Name}">
      <StackPanel Width="120">
        <Grid>
          <Grid.Style><Style TargetType="Grid"><Setter Property="Height" Value="66"/><Style.Triggers><DataTrigger Binding="{Binding HasRole}" Value="True"><Setter Property="Height" Value="60"/></DataTrigger></Style.Triggers></Style></Grid.Style>
          <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="{StaticResource ToolAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Icon}" Width="60" Height="60" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>
        <TextBlock Text="{Binding Name}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Width" Value="92"/><Setter Property="Height" Value="36"/><Setter Property="Margin" Value="0,12,0,0"/><Style.Triggers><DataTrigger Binding="{Binding OptionsCommand}" Value="{x:Null}"><Setter Property="Width" Value="120"/></DataTrigger><DataTrigger Binding="{Binding HasRole}" Value="True"><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="0,8,0,0"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding RoleLabel}" FontSize="10" Foreground="{StaticResource ToolAccent}" TextAlignment="Center" Height="14" Margin="0,2,0,0">
          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasRole}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </ToggleButton>
    <!-- Keep editing outside the playback toggle so its click cannot play a sound. -->
    <Button x:Name="OptionsButton" Style="{StaticResource ToolTileOptions}" IsEnabled="{Binding Editable}" Command="{Binding OptionsCommand}" CommandParameter="{Binding}" ToolTip="Edit sound" AutomationProperties.Name="{Binding Name, StringFormat='Options for {0}'}">
      <TextBlock Text="&#x22EE;" FontFamily="Segoe UI" FontSize="20"/>
    </Button>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsMouseOver, ElementName=TileRoot}" Value="True"><Setter TargetName="OptionsButton" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=TileRoot}" Value="True"><Setter TargetName="OptionsButton" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding OptionsCommand}" Value="{x:Null}"><Setter TargetName="OptionsButton" Property="Visibility" Value="Collapsed"/></DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
