{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build UtilityTool", "type": "process", "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\build.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true}, "problemMatcher": "$msCompile"
    },
    {
      "label": "Run UtilityTool", "type": "process", "command": "${workspaceFolder}\\bin\\Debug\\net48\\UtilityTool.exe",
      "options": {"cwd": "${workspaceFolder}"}, "dependsOn": "Build UtilityTool", "problemMatcher": []
    },
    {
      "label": "Preview WPF UI (sample data)", "type": "process", "command": "${workspaceFolder}\\bin\\Debug\\net48\\UtilityTool.exe", "args": ["--preview"],
      "options": {"cwd": "${workspaceFolder}"}, "dependsOn": "Build UtilityTool", "problemMatcher": []
    },
    {
      "label": "Run legacy WinForms UI", "type": "process", "command": "${workspaceFolder}\\bin\\Debug\\net48\\UtilityTool.exe", "args": ["--legacy"],
      "options": {"cwd": "${workspaceFolder}"}, "dependsOn": "Build UtilityTool", "problemMatcher": []
    }
  ]
}
