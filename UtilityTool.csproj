<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <StartupObject>UtilityTool.Program</StartupObject>
    <RootNamespace>UtilityTool</RootNamespace>
    <AssemblyName>UtilityTool</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <TargetFrameworkRootPath Condition="Exists('$(MSBuildProjectDirectory)\.tools\net48\build\.NETFramework\v4.8\mscorlib.dll')">$(MSBuildProjectDirectory)\.tools\net48\build\</TargetFrameworkRootPath>
    <AutomaticallyUseReferenceAssemblyPackages Condition="Exists('$(MSBuildProjectDirectory)\.tools\net48\build\.NETFramework\v4.8\mscorlib.dll')">false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <ItemGroup>
    <None Update="ThirdParty\*" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <Reference Include="System.Security" />
    <Compile Include="Program.cs" />
    <Compile Include="Frontend\**\*.cs" Exclude="Frontend\TileIconCache.cs;Frontend\DrawingBitmapCache.cs" />
    <Compile Include="Frontend\TileIconCache.cs" />
    <Compile Include="Frontend\DrawingBitmapCache.cs" />
    <Compile Include="Backend\**\*.cs" />
  </ItemGroup>
</Project>
